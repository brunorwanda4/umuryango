{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Umuryango",
  "version": "0.1.2",
  "identifier": "rw.umuryango.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:4914"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Umuryango",
        "url": "/auth/login",
        "width": 1280,
        "height": 840,
        "minWidth": 375,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:4914; img-src 'self' asset: http://asset.localhost http://localhost:4914 data: blob:; style-src 'self' 'unsafe-inline' http://localhost:4914; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:4914; connect-src 'self' ipc: http://ipc.localhost http://localhost:4914 http://localhost:4915 ws://localhost:4914;",
      "capabilities": ["default", "updater"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDNDNFNDRFNDM5MTk2QjcKUldTM2xwRkRUdVJEekgzYTA0V29mNFYyUlBxQ0xFWVJGRk1wQ2RLWDBobkJ3RTdVQ2NKMGgyUWgK",
      "endpoints": [
        "https://github.com/brunorwanda4/umuryango/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
