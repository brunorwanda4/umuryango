DATABASE_URL="postgresql://postgres:0004@localhost:5432/rwanda_backend"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS="30"
FRONTEND_URL="http://localhost:4914"
PORT="4915"
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:4914,http://127.0.0.1:4914,http://192.168.1.76:4914"

# Set to "true" to log verification/reset codes to the console instead of sending email (local dev).
MAIL_DEV_MODE="false"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-smtp-user@example.com"
SMTP_PASS="your-smtp-app-password"
SMTP_FROM="your-smtp-user@example.com"

GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4915/api/v1/auth/google/callback"

# Production with the Vercel frontend proxy should use the frontend callback URL:
# GOOGLE_CALLBACK_URL="https://rwanda-family.vercel.app/api/v1/auth/google/callback"
